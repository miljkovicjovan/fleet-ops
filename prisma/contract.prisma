// use prisma-8

model User {
    id           String            @id
    email        String            @unique
    passwordHash String
    createdAt    TimestamptzString
    updatedAt    TimestamptzString
}

model Vessel {
    id          String        @id
    name        String
    imo         String        @unique
    status      VesselStatus
    latitude    Float
    longitude   Float
    speed       Float
    heading     Float
    lastUpdated TimestamptzString
}

enum VesselStatus {
    active
    offline
    inactive
}